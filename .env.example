# ==============================================================================
# Autonomous Enterprise Platform - Environment Variables Template
# All passwords and secrets below are PLACEHOLDERS for local development only.
# DO NOT commit production credentials or actual secrets to version control.
# ==============================================================================

# PostgreSQL Configuration
DATABASE_DRIVER=in-memory
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=autonomous_enterprise
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/autonomous_enterprise

# Redis Configuration
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PASSWORD=your_redis_password_here
REDIS_PORT=6379

# Apache Kafka Configuration (KRaft Single-Node)
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=autonomous-enterprise-api
KAFKA_TOPIC=enterprise.events
KAFKA_GROUP_ID=autonomous-enterprise-workers
KAFKA_PORT=9092
KAFKA_CONTROLLER_PORT=9093
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# Keycloak Configuration
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=your_keycloak_admin_password_here
KEYCLOAK_PORT=8080
# Keycloak is published through the gateway at /auth, so it runs with this
# relative path and emits issuer/redirect URLs that already include it.
KEYCLOAK_RELATIVE_PATH=/auth
KEYCLOAK_ISSUER=http://localhost:8080/auth/realms/autonomous-enterprise
KEYCLOAK_JWKS_URI=http://localhost:8080/auth/realms/autonomous-enterprise/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=autonomous-enterprise-api
KEYCLOAK_SECRET=your_jwt_secret_for_local_dev

# Auth Behavior
AUTH_BYPASS_HEADER_TRUST=false

# AI Provider Abstraction (OmniRouter) - reserved for Phase 4 Controlled AI Layer
OMNIROUTER_BASE_URL=https://your-omnirouter-endpoint.example.com
OMNIROUTER_API_KEY=your_omnirouter_api_key_here

# Kubernetes Integration (Phase 6 Infrastructure Orchestration)
# Path to a kubeconfig file used by the Infrastructure module's Kubernetes client.
# If unset, the default kubeconfig discovery (~/.kube/config or in-cluster config) is used.
KUBECONFIG_PATH=

# HTTP Server (Phase 7 Hardening)
PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173

# ==============================================================================
# Docker Compose: containerised frontend + nginx API gateway
# ==============================================================================

# Public port of the nginx gateway. This is the only port users need:
#   http://localhost/            -> web SPA
#   http://localhost/api/v1/...  -> API
#   http://localhost/auth/       -> Keycloak
GATEWAY_PORT=80

# Host port for direct API access (debugging only; normal traffic goes via the
# gateway). Set to a free port if 3000 is already in use on the host.
API_PORT=3000

# API base URL baked into the SPA at container start. Keep it relative so the
# browser always talks to the gateway that served the page.
PUBLIC_API_BASE_URL=/api/v1

# Node environment for the containerised API. Keep this at development for the
# local stack: with NODE_ENV=production the auth guard rejects every request
# that has no bearer token, so the UI cannot load until Keycloak is configured.
NODE_ENV=development
